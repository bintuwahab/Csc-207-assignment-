#include <iostream>
using namespace std;

int main() {
    int num;

    cout << "Enter a number: ";
    cin >> num;

    // if the remainder is 0 when divided by 2, it is even
    if (num % 2 == 0) {
        cout << num << " is an Even number" << endl;
    }
    else {
        cout << num << " is an Odd number" << endl;
    }

    return 0;
}
